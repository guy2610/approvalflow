APP_ENV=local
LOG_LEVEL=info

# Auth demo secret only. Never commit real secrets.
JWT_SECRET=dev-only-change-me

# Postgres
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=approvalflow
POSTGRES_DB=approvalflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Dapr
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# AI provider
AI_PROVIDER=stub
AGENT_SERVICE_URL=http://agent-service:8080

# Policy
POLICY_PATH=/app/data/policy.md
SAMPLE_INVOICES_PATH=/app/data/sample-invoices.json

# Autonomy thresholds, must match docs/PRODUCT-DILEMMA.md
AUTONOMY_CEILING_USD=250
AUTONOMY_CONFIDENCE=0.80